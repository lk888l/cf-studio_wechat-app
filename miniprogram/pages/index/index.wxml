<view class="product-home">
  <view class="home-header">
    <view class="studio-sign"
      ><view class="studio-mark"><view></view><view></view><view></view></view
      ><text>CF STUDIO</text></view
    >
    <text class="header-caption">让灵感动起来</text>
  </view>
  <view class="intro">
    <text class="eyebrow">EXPLORE YOUR NEXT MOVE</text>
    <text class="intro-title">每一次探索，<text class="intro-accent">从这里开始。</text></text>
    <text class="intro-copy">选择你的产品，开启掌心里的操控体验。</text>
  </view>
  <view class="collection-heading"
    ><text>我的产品</text
    ><text class="collection-count"
      >{{products.length > 9 ? '' : '0'}}{{products.length}} 款可用</text
    ></view
  >
  <view wx:if="{{error}}" class="message error-message">{{error}}</view>
  <view class="collection-grid">
    <button
      wx:for="{{products}}"
      wx:key="id"
      class="product-card"
      data-id="{{item.id}}"
      bindtap="openProduct"
      disabled="{{!!openingId}}"
      hover-class="product-card-pressed"
      aria-label="{{item.name}}，{{lastProductId === item.id ? '上次使用，' : ''}}进入遥控台"
    >
      <view class="product-visual">
        <view class="visual-topline"
          ><text class="series-label">WHEEL-LEGGED ROBOT</text
          ><text class="product-badge {{lastProductId === item.id ? 'badge-recent' : ''}}"
            >{{lastProductId === item.id ? '上次使用' : '探索系列'}}</text
          ></view
        >
        <text class="model-watermark">{{item.model}}</text>
        <view class="orbit orbit-outer"></view><view class="orbit orbit-inner"></view>
        <image class="robot-image" src="{{item.image}}" mode="aspectFit" aria-hidden="true" />
        <view class="visual-caption"
          ><view class="availability-dot"></view><text>灵活移动 · 自由操控</text
          ><text class="visual-index">01 / CF</text></view
        >
      </view>
      <view class="product-details">
        <view class="product-title-row"
          ><text class="product-title">{{item.name}}</text
          ><text class="model-label">{{item.model}}</text></view
        >
        <text class="product-description">{{item.description}}</text>
        <view class="product-tags"
          ><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="product-tag"
            >{{tag}}</text
          ></view
        >
        <view class="enter-product"
          ><text>{{openingId === item.id ? '正在进入…' : '进入遥控台'}}</text
          ><text class="enter-arrow">↗</text></view
        >
      </view>
    </button>
    <view class="coming-card">
      <view class="coming-symbol"><view></view><view></view></view>
      <view class="coming-copy"
        ><text class="coming-title">更多可能，正在路上</text
        ><text class="coming-description">新的产品，将在这里与你见面。</text></view
      >
      <text class="coming-label">SOON</text>
    </view>
  </view>
  <view class="preferences">
    <view class="preference-row">
      <view class="memory-icon"><view></view><view></view></view>
      <view class="preference-copy"
        ><text class="preference-title">下次自动进入</text
        ><text class="preference-description"
          >{{autoEnter ? '打开时，直接进入上次使用的产品' : '打开时，停留在产品选择页'}}</text
        ></view
      >
      <switch
        class="memory-switch"
        checked="{{autoEnter}}"
        disabled="{{!!openingId}}"
        color="#3178bb"
        bindchange="toggleAutoEnter"
        aria-label="下次打开时自动进入上次使用的产品"
      />
    </view>
    <text wx:if="{{storageNotice}}" class="storage-notice">{{storageNotice}}</text>
    <view class="preference-footer"
      ><text>选择会保存在本机</text><text>可随时在遥控页切换产品</text></view
    >
  </view>
  <view class="home-footer"><view></view><text>CF STUDIO · 为探索而造</text><view></view></view>
</view>
