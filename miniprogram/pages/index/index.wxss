page {
  height: auto;
  min-height: 100%;
  overflow: auto;
  background: #f5f8fc;
  color: #203c56;
}
.product-home {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px 24px 18px;
  padding-bottom: calc(18px + env(safe-area-inset-bottom));
}
.home-header,
.studio-sign,
.studio-mark,
.collection-heading,
.visual-topline,
.visual-caption,
.product-title-row,
.enter-product,
.coming-card,
.preference-row,
.preference-footer,
.home-footer {
  display: flex;
  align-items: center;
}
.home-header,
.collection-heading,
.visual-topline,
.product-title-row,
.enter-product,
.preference-footer {
  justify-content: space-between;
}
.studio-sign {
  gap: 9px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 1.4px;
}
.studio-mark {
  gap: 3px;
  height: 22px;
  transform: skew(-16deg);
}
.studio-mark view {
  width: 4px;
  height: 18px;
  border-radius: 1px;
  background: #3178bb;
}
.studio-mark view:last-child {
  height: 11px;
  background: #87bae5;
}
.header-caption {
  font-size: 10px;
  color: #7b8da1;
  letter-spacing: 1px;
}
.intro {
  padding: 38px 0 31px;
}
.eyebrow {
  display: block;
  color: #6084a7;
  font-size: 9px;
  font-weight: 650;
  letter-spacing: 2px;
}
.intro-title {
  display: block;
  margin-top: 13px;
  font-size: 30px;
  font-weight: 700;
  letter-spacing: -1px;
  line-height: 1.42;
}
.intro-accent {
  display: block;
  color: #3178bb;
}
.intro-copy {
  display: block;
  margin-top: 12px;
  font-size: 12px;
  color: #73879a;
  line-height: 1.8;
}
.collection-heading {
  margin-bottom: 13px;
  font-size: 13px;
  font-weight: 650;
}
.collection-count {
  color: #8192a5;
  font-size: 10px;
  font-weight: 400;
  letter-spacing: 0.5px;
}
.collection-grid {
  display: grid;
  gap: 14px;
}
.product-card,
.product-card[disabled] {
  width: 100%;
  padding: 0;
  overflow: hidden;
  text-align: left;
  color: #203c56;
  border: 1px solid #dce8f2;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(39, 77, 112, 0.05);
}
.product-card-pressed {
  opacity: 0.88;
}
.product-visual {
  position: relative;
  height: 238px;
  overflow: hidden;
  background: linear-gradient(135deg, #edf7ff 0%, #dbeefa 60%, #c8e1f5 100%);
}
.visual-topline {
  position: absolute;
  z-index: 2;
  top: 18px;
  left: 20px;
  right: 20px;
  gap: 8px;
}
.series-label {
  color: #557d9f;
  font-size: 8px;
  font-weight: 650;
  letter-spacing: 1.2px;
}
.product-badge {
  padding: 5px 9px;
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.55);
  color: #6487a4;
  font-size: 9px;
  white-space: nowrap;
}
.badge-recent {
  color: #28699f;
  background: #fff;
}
.model-watermark {
  position: absolute;
  top: 38px;
  left: 22px;
  color: #fff;
  opacity: 0.63;
  font-size: 99px;
  font-weight: 800;
  letter-spacing: -6px;
  line-height: 1;
}
.orbit {
  position: absolute;
  width: 270px;
  height: 270px;
  top: 10px;
  right: -54px;
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 50%;
}
.orbit-inner {
  width: 220px;
  height: 220px;
  top: 35px;
  right: -29px;
}
.robot-image {
  position: absolute;
  z-index: 1;
  top: 22px;
  left: 0;
  width: 100%;
  height: 206px;
}
.visual-caption {
  position: absolute;
  bottom: 16px;
  left: 20px;
  right: 20px;
  gap: 6px;
  color: #5d829f;
  font-size: 8px;
  letter-spacing: 1px;
}
.availability-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #5e99c6;
}
.visual-index {
  margin-left: auto;
  font-size: 8px;
  letter-spacing: 1px;
}
.product-details {
  padding: 20px;
}
.product-title {
  font-size: 23px;
  font-weight: 700;
  letter-spacing: -0.5px;
}
.model-label {
  padding: 4px 8px;
  border: 1px solid #dfe9f1;
  border-radius: 5px;
  color: #5d7c96;
  font-size: 10px;
  font-weight: 650;
  letter-spacing: 1px;
}
.product-description {
  display: block;
  margin-top: 8px;
  color: #7b8ea0;
  font-size: 11px;
  line-height: 1.8;
}
.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  margin-top: 16px;
}
.product-tag {
  padding: 5px 8px;
  border-radius: 5px;
  background: #f1f6fa;
  color: #5c7a94;
  font-size: 9px;
}
.enter-product {
  min-height: 45px;
  margin-top: 21px;
  padding: 0 16px;
  border-radius: 11px;
  background: #2c6597;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
}
.enter-arrow {
  font-size: 22px;
  font-weight: 400;
}
.coming-card {
  position: relative;
  min-height: 92px;
  gap: 13px;
  padding: 19px 17px;
  border: 1px dashed #cbdbe8;
  border-radius: 17px;
  background: rgba(255, 255, 255, 0.35);
}
.coming-symbol {
  position: relative;
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  border: 1px solid #d6e2ed;
  border-radius: 10px;
  transform: rotate(-6deg);
}
.coming-symbol view {
  position: absolute;
  top: 15px;
  left: 10px;
  width: 12px;
  height: 1px;
  background: #8da8bf;
}
.coming-symbol view:last-child {
  transform: rotate(90deg);
}
.coming-copy {
  flex: 1;
  min-width: 0;
}
.coming-title {
  display: block;
  color: #71869a;
  font-size: 12px;
  font-weight: 550;
}
.coming-description {
  display: block;
  margin-top: 6px;
  color: #92a1af;
  font-size: 10px;
  line-height: 1.6;
}
.coming-label {
  color: #a0afbc;
  font-size: 8px;
  letter-spacing: 1px;
}
.preferences {
  margin-top: 25px;
  overflow: hidden;
  border: 1px solid #e3ebf2;
  border-radius: 15px;
  background: #fff;
}
.preference-row {
  padding: 17px 15px;
  gap: 11px;
}
.memory-icon {
  position: relative;
  width: 26px;
  height: 26px;
  flex-shrink: 0;
}
.memory-icon view {
  position: absolute;
  width: 15px;
  height: 18px;
  left: 3px;
  top: 2px;
  border: 1.5px solid #8faac2;
  border-radius: 4px;
  background: #fff;
}
.memory-icon view:last-child {
  left: 8px;
  top: 7px;
  background: #eef5fb;
}
.preference-copy {
  flex: 1;
  min-width: 0;
}
.preference-title {
  display: block;
  font-size: 12px;
  font-weight: 600;
}
.preference-description {
  display: block;
  margin-top: 6px;
  font-size: 10px;
  color: #8a9aaa;
  line-height: 1.6;
}
.memory-switch {
  flex-shrink: 0;
  transform: scale(0.72);
  transform-origin: right center;
  margin-left: -12px;
}
.preference-footer {
  flex-wrap: wrap;
  gap: 5px;
  padding: 11px 16px;
  background: #fafcfe;
  border-top: 1px solid #eef3f7;
  color: #91a1b0;
  font-size: 9px;
}
.home-footer {
  justify-content: center;
  gap: 13px;
  margin-top: 29px;
  color: #a0afbd;
  font-size: 8px;
  letter-spacing: 1.3px;
}
.home-footer view {
  height: 1px;
  width: 23px;
  background: #dce5ed;
}
.message,
.storage-notice {
  color: #956235;
  background: #fff4e8;
  font-size: 12px;
  line-height: 1.7;
}
.error-message {
  padding: 12px;
  margin-bottom: 12px;
  border-radius: 10px;
}
.storage-notice {
  display: block;
  padding: 10px 16px;
}
@media (min-width: 600px) {
  .product-home {
    padding: 28px 40px;
  }
  .intro {
    padding-top: 35px;
  }
  .intro-title {
    font-size: 36px;
  }
  .intro-accent {
    display: inline;
  }
  .collection-grid {
    grid-template-columns: 1.6fr 1fr;
    align-items: stretch;
    gap: 20px;
  }
  .product-visual {
    height: 250px;
  }
  .robot-image {
    height: 222px;
  }
  .coming-card {
    flex-direction: column;
    justify-content: center;
    text-align: center;
    gap: 20px;
  }
  .coming-copy {
    flex: 0;
  }
  .coming-symbol {
    width: 50px;
    height: 50px;
    border-radius: 15px;
  }
  .coming-symbol view {
    top: 23px;
    left: 15px;
    width: 18px;
  }
  .coming-title {
    font-size: 16px;
  }
  .coming-description {
    margin-top: 10px;
    font-size: 12px;
  }
  .coming-label {
    position: absolute;
    top: 23px;
    right: 23px;
  }
  .preference-row {
    padding: 20px;
  }
}
@media (max-width: 350px) {
  .product-home {
    padding-left: 16px;
    padding-right: 16px;
  }
  .intro-title {
    font-size: 27px;
  }
  .coming-label {
    display: none;
  }
  .preference-row {
    gap: 7px;
    padding-left: 11px;
    padding-right: 11px;
  }
  .memory-icon {
    display: none;
  }
}
