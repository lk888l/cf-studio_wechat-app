{
  "singleQuote": true,
  "semi": true,
  "printWidth": 100,
  "endOfLine": "auto",
  "overrides": [
    { "files": "*.wxml", "options": { "parser": "html" } },
    { "files": "*.wxss", "options": { "parser": "css" } },
    { "files": "*.wxs", "options": { "parser": "babel", "trailingComma": "es5" } }
  ]
}
